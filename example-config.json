{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "cache.db",
      "store_rdrc": true
    }
  },
  "dns": {
    "servers": [
      {
        "tag": "dns_proxy",
        "address": "https://1.1.1.1/dns-query",
        "detour": "proxy",
        "strategy": "prefer_ipv4"
      },
      {
        "tag": "dns_direct",
        "address": "https://dns.alidns.com/dns-query",
        "detour": "direct",
        "strategy": "prefer_ipv4"
      },
      {
        "tag": "dns_local",
        "address": "local",
        "detour": "direct"
      },
      {
        "tag": "dns_block",
        "address": "rcode://success"
      }
    ],
    "rules": [
      {
        "outbound": "any",
        "server": "dns_local"
      },
      {
        "rule_set": [
          "geosite-ads"
        ],
        "server": "dns_block",
        "disable_cache": true
      },
      {
        "rule_set": [
          "geosite-cn",
          "geosite-private"
        ],
        "server": "dns_direct"
      },
      {
        "rule_set": [
          "geosite-geolocation-!cn"
        ],
        "server": "dns_proxy"
      }
    ],
    "final": "dns_proxy",
    "strategy": "prefer_ipv4",
    "independent_cache": true
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "tun0",
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "mtu": 9000,
      "auto_route": true,
      "strict_route": true,
      "stack": "system",
      "sniff": true,
      "sniff_override_destination": true
    },
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 2080,
      "sniff": true,
      "sniff_override_destination": true
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "block",
      "tag": "block"
    },
    {
      "type": "dns",
      "tag": "dns-out"
    },
    {
      "type": "selector",
      "tag": "proxy",
      "outbounds": [
        "节点1",
        "节点2",
        "auto"
      ],
      "default": "auto"
    },
    {
      "type": "urltest",
      "tag": "auto",
      "outbounds": [
        "节点1",
        "节点2"
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "5m"
    }
  ],
  "route": {
    "rule_set": [
      {
        "type": "remote",
        "tag": "geosite-private",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/dian-sen/singbox-ruleset@main/geosite/private.srs",
        "download_detour": "proxy"
      },
      {
        "type": "remote",
        "tag": "geosite-ads",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/dian-sen/singbox-ruleset@main/geosite/ads.srs",
        "download_detour": "proxy"
      },
      {
        "type": "remote",
        "tag": "geosite-cn",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/dian-sen/singbox-ruleset@main/geosite/cn.srs",
        "download_detour": "proxy"
      },
      {
        "type": "remote",
        "tag": "geosite-geolocation-!cn",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/dian-sen/singbox-ruleset@main/geosite/geolocation-!cn.srs",
        "download_detour": "proxy"
      },
      {
        "type": "remote",
        "tag": "geosite-google",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/dian-sen/singbox-ruleset@main/geosite/google.srs",
        "download_detour": "proxy"
      },
      {
        "type": "remote",
        "tag": "geosite-youtube",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/dian-sen/singbox-ruleset@main/geosite/youtube.srs",
        "download_detour": "proxy"
      },
      {
        "type": "remote",
        "tag": "geosite-netflix",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/dian-sen/singbox-ruleset@main/geosite/netflix.srs",
        "download_detour": "proxy"
      },
      {
        "type": "remote",
        "tag": "geosite-openai",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/dian-sen/singbox-ruleset@main/geosite/openai.srs",
        "download_detour": "proxy"
      },
      {
        "type": "remote",
        "tag": "geosite-telegram",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/dian-sen/singbox-ruleset@main/geosite/telegram.srs",
        "download_detour": "proxy"
      },
      {
        "type": "remote",
        "tag": "geosite-discord",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/dian-sen/singbox-ruleset@main/geosite/discord.srs",
        "download_detour": "proxy"
      },
      {
        "type": "remote",
        "tag": "geosite-twitter",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/dian-sen/singbox-ruleset@main/geosite/twitter.srs",
        "download_detour": "proxy"
      },
      {
        "type": "remote",
        "tag": "geosite-github",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/dian-sen/singbox-ruleset@main/geosite/github.srs",
        "download_detour": "proxy"
      },
      {
        "type": "remote",
        "tag": "geoip-private",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/dian-sen/singbox-ruleset@main/geoip/geoip-private.srs",
        "download_detour": "proxy"
      },
      {
        "type": "remote",
        "tag": "geoip-cn",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/dian-sen/singbox-ruleset@main/geoip/geoip-cn.srs",
        "download_detour": "proxy"
      },
      {
        "type": "remote",
        "tag": "geoip-telegram",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/dian-sen/singbox-ruleset@main/geoip/geoip-telegram.srs",
        "download_detour": "proxy"
      },
      {
        "type": "remote",
        "tag": "geosite-anthropic",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/dian-sen/singbox-ruleset@main/geosite/anthropic.srs",
        "download_detour": "proxy"
      },
      {
        "type": "remote",
        "tag": "geosite-deepseek",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/dian-sen/singbox-ruleset@main/geosite/deepseek.srs",
        "download_detour": "proxy"
      },
      {
        "type": "remote",
        "tag": "geosite-xai",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/dian-sen/singbox-ruleset@main/geosite/xai.srs",
        "download_detour": "proxy"
      },
      {
        "type": "remote",
        "tag": "geosite-perplexity",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/dian-sen/singbox-ruleset@main/geosite/perplexity.srs",
        "download_detour": "proxy"
      },
      {
        "type": "remote",
        "tag": "geosite-tiktok",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/dian-sen/singbox-ruleset@main/geosite/tiktok.srs",
        "download_detour": "proxy"
      }
    ],
    "rules": [
      {
        "protocol": "dns",
        "outbound": "dns-out"
      },
      {
        "rule_set": [
          "geosite-ads"
        ],
        "outbound": "block"
      },
      {
        "rule_set": [
          "geosite-private",
          "geoip-private"
        ],
        "outbound": "direct"
      },
      {
        "rule_set": [
          "geosite-google",
          "geosite-youtube",
          "geosite-netflix",
          "geosite-openai",
          "geosite-telegram",
          "geosite-discord",
          "geosite-twitter",
          "geosite-github",
          "geosite-anthropic",
          "geosite-deepseek",
          "geosite-xai",
          "geosite-perplexity",
          "geosite-tiktok"
        ],
        "outbound": "proxy"
      },
      {
        "rule_set": [
          "geoip-telegram"
        ],
        "outbound": "proxy"
      },
      {
        "rule_set": [
          "geosite-cn",
          "geoip-cn"
        ],
        "outbound": "direct"
      },
      {
        "rule_set": [
          "geosite-geolocation-!cn"
        ],
        "outbound": "proxy"
      }
    ],
    "final": "proxy",
    "auto_detect_interface": true
  }
}
